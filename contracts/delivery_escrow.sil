pragma silverscript ^0.1.0;

// DeliveryEscrow v0.2 — paiement à la livraison pour agent IA.
//
// v0.2 : une seule entrée imposée. Sans cette règle, deux séquestres pouvaient être fusionnés
// dans une même transaction dont l'unique sortie ne vaut qu'un séquestre : l'autre partait en
// frais chez le mineur (attaque possible par n'importe qui, aucune signature n'étant demandée).
//
// L'agent paie depuis son coffre AgentBudget vers ce séquestre au lieu de payer le vendeur.
//  - claim  : le vendeur est payé SEULEMENT si un vérificateur a signé la preuve de livraison
//             de CETTE commande (empreinte de la requête + empreinte du résultat livré).
//  - refund : sans preuve dans le délai, n'importe qui peut renvoyer l'argent au propriétaire.
// Aucune signature n'est demandée pour déclencher l'un ou l'autre : la destination est fixée
// par le contrat (vendeur ou propriétaire), seuls les frais sont bornés.

contract DeliveryEscrow(
    byte[32] merchantSpkHash, // empreinte blake2b du script de paiement du vendeur
    byte[32] refundSpkHash,   // empreinte blake2b du script de remboursement (propriétaire)
    pubkey verifierKey,       // clé du vérificateur qui atteste la livraison
    byte[32] requestHash,     // identifiant unique de la commande
    int timeoutDaa,           // délai (en unités DAA) avant remboursement possible
    int maxFee                // frais maximum prélevés sur le séquestre
) {
    // Livraison prouvée : le vérificateur a signé blake2b(requestHash || resultHash).
    entry claim(datasig proof, byte[32] resultHash) {
        byte[] message = byte[](requestHash) + byte[](resultHash);
        require(checkMsgSig(proof, blake2b(message), verifierKey));
        require(tx.inputs.length == 1);
        require(tx.outputs.length == 1);
        require(blake2b(tx.outputs[0].scriptPubKey) == merchantSpkHash);
        require(tx.outputs[0].value >= tx.inputs[this.activeInputIndex].value - maxFee);
    }

    // Pas de preuve dans le délai : remboursement au propriétaire.
    entry refund() {
        require(this.ageDaa >= timeoutDaa);
        require(tx.inputs.length == 1);
        require(tx.outputs.length == 1);
        require(blake2b(tx.outputs[0].scriptPubKey) == refundSpkHash);
        require(tx.outputs[0].value >= tx.inputs[this.activeInputIndex].value - maxFee);
    }
}
